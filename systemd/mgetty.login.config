# /etc/mgetty/login.config for the qico modem line.
#
# mgetty (built with FIDO, fido-send-emsi y) sets the login name to
# /FIDO/ after EMSI_REQ / EMSI_INQ and execs the matching line as map.
# qico -a emsi continues the session without sending EMSI_REQ again.
# Carrier is the tty0tty DCD line. qico reads it with TIOCMGET.
#
# Anything that is not a Fido call gets nologin and the port is released.
# A voice caller must not be left sitting in /bin/login.

/FIDO/	map	map	/home/map/ftn/usr/bin/qico -I /home/map/ftn/usr/etc/qico/qico.conf -a emsi
*	-	-	/usr/sbin/nologin
